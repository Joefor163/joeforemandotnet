<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent — Joe Foreman site auto-push
  Installed to: ~/Library/LaunchAgents/com.joeforeman.autopush.plist
  Wakes auto-push.sh whenever a file inside the joeforemandotnet repo changes.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.joeforeman.autopush</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPO_PATH/.auto-push/auto-push.sh</string>
  </array>

  <!--
    Trigger ONLY on changes inside the joeforemandotnet repo.
    No polling, no schedule — launchd wakes the script the moment
    anything in the folder is added, modified, or removed.
  -->
  <key>WatchPaths</key>
  <array>
    <string>REPO_PATH</string>
  </array>

  <!--
    Also run once at login to catch any changes that happened while
    the daemon was offline (e.g. edits made on another machine and
    pulled in, or files added while logged out).
  -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Don't keep alive — the script should exit and wait for the
       next file-change event. -->
  <key>KeepAlive</key>
  <false/>

  <!-- Coalesce rapid bursts of file changes into a single run.
       (e.g. saving many files at once won't queue 10 runs.) -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>HOME_PATH/Library/Logs/joeforeman-auto-push.log</string>

  <key>StandardErrorPath</key>
  <string>HOME_PATH/Library/Logs/joeforeman-auto-push.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
